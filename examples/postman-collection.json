{
  "info": {
    "name": "n8n POC API",
    "description": "Collection of API endpoints for n8n POC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/health"
      }
    },
    {
      "name": "Send Webhook Data",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:3000/webhook/automation",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workflowId\": \"workflow_001\",\n  \"timestamp\": \"2024-01-15T10:30:00Z\",\n  \"data\": {\n    \"userId\": \"user_123\",\n    \"action\": \"signup\",\n    \"email\": \"john@example.com\"\n  }\n}"
        }
      }
    },
    {
      "name": "Get Logs",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/logs"
      }
    },
    {
      "name": "Workflow Status",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/workflow-status/workflow_001"
      }
    },
    {
      "name": "Trigger Workflow",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:3000/api/trigger-workflow",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workflowId\": \"123\",\n  \"data\": {\n    \"message\": \"Hello from Node.js\",\n    \"timestamp\": \"2024-01-15T10:30:00Z\"\n  }\n}"
        }
      }
    }
  ]
}
