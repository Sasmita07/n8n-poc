# n8n Configuration
N8N_URL=http://localhost:5678
N8N_API_KEY=replace_with_your_n8n_api_key
N8N_WEBHOOK_URL=http://localhost:3000/webhook
N8N_SMTP_CREDENTIAL_ID=replace_with_your_n8n_smtp_credential_id
N8N_SMTP_CREDENTIAL_NAME=SMTP account
N8N_APPROVAL_REQUEST_WEBHOOK_PATH=approval-request
N8N_APPROVAL_DECISION_WEBHOOK_PATH=approval-decision

# SMTP for n8n Send Email node
N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=replace_with_your_smtp_username
N8N_SMTP_PASS=replace_with_your_smtp_password
N8N_SMTP_SENDER=noreply@example.com
N8N_SMTP_SSL=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (optional)
DB_URL=mongodb://localhost:27017/n8n-poc
