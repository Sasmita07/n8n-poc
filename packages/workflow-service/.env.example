# n8n Configuration
N8N_URL=http://localhost:5678
N8N_API_KEY=replace_with_your_n8n_api_key
N8N_SMTP_CREDENTIAL_ID=replace_with_your_n8n_smtp_credential_id
N8N_SMTP_CREDENTIAL_NAME=SMTP account
N8N_APPROVAL_REQUEST_WEBHOOK_PATH=approval-request
N8N_APPROVAL_DECISION_WEBHOOK_PATH=approval-decision
N8N_AI_DECISION_WEBHOOK_PATH=ai-decision

# AI provider (server-side only; use a compatible chat-completions endpoint)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=replace_with_your_provider_key
AI_MODEL=gpt-4o-mini

# Sender address used by the generated n8n Send Email node. SMTP credentials
# themselves are created and stored in n8n, not in this file.
N8N_SMTP_SENDER=noreply@example.com

# Server Configuration
PORT=3000
NODE_ENV=development
