# n8n Configuration
N8N_URL=http://localhost:5678
N8N_API_KEY=your_api_key_here
N8N_WEBHOOK_URL=http://localhost:3000/webhook
N8N_SMTP_CREDENTIAL_ID=N8N_SMTP_CREDENTIAL_ID
N8N_SMTP_CREDENTIAL_NAME=N8N_SMTP_CREDENTIAL_NAME

# SMTP for n8n Send Email node
N8N_SMTP_HOST=N8N_SMTP_HOST
N8N_SMTP_PORT=N8N_SMTP_PORT
N8N_SMTP_USER=N8N_SMTP_USER
N8N_SMTP_PASS=N8N_SMTP_PASS
N8N_SMTP_SENDER=N8N_SMTP_SENDER
N8N_SMTP_SSL=N8N_SMTP_SSL


# Server Configuration
PORT=3000
NODE_ENV=development

# Database (optional)
DB_URL=mongodb://localhost:27017/n8n-poc
